---
import { works, workIntro, filters } from '../data/site';
import Media from './Media.astro';
// Only show filters that have at least one project
const used = filters.filter((f) => f === 'All' || works.some((w) => w.category === f));
---

<section class="work section container" id="work" data-section>
  <div class="work__head">
    <div>
      <p class="eyebrow">Act II — Selected Work</p>
      <h2 class="h2">Selected work</h2>
      <p class="work__intro">{workIntro}</p>
    </div>
    <div class="filters" role="group" aria-label="Filter work">
      {used.map((f, i) => (
        <button type="button" class="filter mono" data-filter={f} aria-pressed={i === 0 ? 'true' : 'false'}>
          {f}
        </button>
      ))}
    </div>
  </div>

  <ul class="grid" data-work-grid>
    {works.map((w, i) => {
      const Tag = w.link ? 'a' : 'div';
      return (
        <li class="work-card" data-category={w.category} data-reveal style={`--d:${(i % 3) * 0.08}s`}>
          <Tag class="work-card__inner" {...(w.link ? { href: w.link, target: '_blank', rel: 'noopener noreferrer' } : {})}>
            <div class="work-card__frame">
              <Media src={w.image} alt={`Still from ${w.title}`} label="FRAME GRAB" />
              <span class="work-card__no mono">{w.no}</span>
            </div>
            <div class="work-card__row">
              <h3 class="display">{w.title}</h3>
              <span class="mono">{w.format}</span>
            </div>
            <p class="work-card__credit mono">{w.credit}</p>
            <p class="work-card__text">{w.text}</p>
          </Tag>
        </li>
      );
    })}
  </ul>
  <p class="work__empty mono" hidden data-work-empty>No projects in this category yet.</p>
</section>

<style>
  .work {
    padding-top: 0;
  }
  .work__head {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 48px;
  }
  .work__intro {
    max-width: 560px;
    margin: 20px 0 0;
    color: var(--muted);
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .filter {
    min-height: 44px;
    padding: 0 18px;
    background: transparent;
    color: var(--text-2);
    border: 1px solid var(--line-3);
    font-size: 12px;
    text-transform: uppercase;
    transition:
      background 0.25s,
      color 0.25s,
      border-color 0.25s;
  }
  .filter:hover {
    border-color: var(--text-2);
  }
  .filter[aria-pressed='true'] {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--bg);
  }
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
    gap: 40px 24px;
  }
  .work-card[hidden] {
    display: none;
  }
  .work-card__inner {
    display: block;
    color: var(--text);
  }
  a.work-card__inner:hover {
    color: var(--text);
  }
  .work-card__frame {
    position: relative;
    aspect-ratio: 2.39 / 1;
    overflow: hidden;
    background: var(--surface);
  }
  .work-card__frame :global(.media),
  .work-card__frame :global(.ph) {
    transition: transform 1s var(--ease);
  }
  .work-card:hover .work-card__frame :global(.media),
  .work-card:hover .work-card__frame :global(.ph) {
    transform: scale(1.05);
  }
  .work-card__no {
    position: absolute;
    top: 10px;
    left: 12px;
    font-size: 10px;
    color: var(--accent);
  }
  .work-card__row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    margin-top: 14px;
  }
  .work-card__row h3 {
    font-size: 24px;
    letter-spacing: 0.5px;
  }
  .work-card__row .mono {
    flex: none;
    max-width: 50%;
    text-align: right;
    font-size: 11px;
    color: var(--muted);
    text-transform: uppercase;
  }
  .work-card__credit {
    margin: 6px 0 0;
    font-size: 11px;
    color: var(--accent);
    text-transform: uppercase;
  }
  .work-card__text {
    margin: 10px 0 0;
    font-size: 15px;
    color: var(--muted);
    line-height: 1.6;
  }
  .work__empty {
    color: var(--dim);
    font-size: 12px;
  }
</style>