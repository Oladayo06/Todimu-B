---
// Image or muted loop if a src is set, otherwise a labelled placeholder.
interface Props {
  src?: string;
  alt?: string;
  label?: string;
  poster?: string;
  eager?: boolean;
  class?: string;
}
const { src = '', alt = '', label = 'Media', poster, eager = false, class: cls = '' } = Astro.props;
const isVideo = /\.(mp4|webm|mov)$/i.test(src);
---

{src ? (
  isVideo ? (
    <video class:list={['media', cls]} src={src} poster={poster} autoplay muted loop playsinline preload="metadata" aria-hidden="true" />
  ) : (
    <img
      class:list={['media', cls]}
      src={src}
      alt={alt}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
      decoding="async"
    />
  )
) : (
  <div class:list={['ph', cls]} role={alt ? 'img' : undefined} aria-label={alt || undefined}>[ {label} ]</div>
)}

<style>
  .media {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>