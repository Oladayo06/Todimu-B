---
import { site, story } from '../data/site';
import Media from './Media.astro';
const [first, ...rest] = story.paragraphs;
---

<section class="story" id="story" data-section>
  <div class="story__inner container section">
    <figure class="story__media" data-reveal>
      <div class="story__main">
        <Media src={site.portraitBw} alt="Todimu Adegoke behind the camera on set" label="B&W PORTRAIT — behind the camera" />
      </div>
      <div class="story__inset">
        <Media src={site.btsStill} alt="Behind-the-scenes production still" label="BTS STILL" />
      </div>
      <figcaption class="story__caption mono">{story.caption}</figcaption>
    </figure>

    <div class="story__copy">
      <p class="eyebrow">Act III — Story</p>
      <h2 class="h2 story__title">{story.headline}</h2>
      <p class="lead story__first">{first}</p>
      <details class="story__more">
        <summary class="mono">Read the full story <span aria-hidden="true">+</span></summary>
        {rest.map((p) => <p>{p}</p>)}
      </details>
      <dl class="stats">
        {story.stats.map((s) => (
          <div>
            <dt>{s.label}</dt>
            <dd class="display">{s.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>

<style>
  .story {
    background: var(--bg-2);
    border-block: 1px solid var(--line);
  }
  .story__inner {
    display: flex;
    flex-wrap: wrap;
    gap: 64px;
    align-items: center;
  }
  .story__media {
    position: relative;
    flex: 1 1 380px;
    min-height: 560px;
    margin: 0;
  }
  .story__main {
    position: absolute;
    inset: 0 60px 100px 0;
    overflow: hidden;
    background: #241c16;
  }
  .story__main :global(.media) {
    filter: grayscale(1) contrast(1.05);
  }
  .story__main :global(.ph) {
    background-color: #241c16;
    background-image: repeating-linear-gradient(45deg, rgba(255, 255, 255, 0.03) 0 2px, transparent 2px 12px);
    filter: grayscale(1);
  }
  .story__inset {
    position: absolute;
    right: 0;
    bottom: 50px;
    width: 220px;
    height: 160px;
    border: 6px solid var(--bg-2);
    overflow: hidden;
    background: #2e2219;
  }
  .story__inset :global(.ph) {
    background-color: #2e2219;
    font-size: 10px;
  }
  .story__caption {
    position: absolute;
    left: 0;
    bottom: 0;
    right: 240px;
    font-size: 11px;
    line-height: 1.5;
    color: var(--dim);
  }
  .story__copy {
    flex: 1 1 480px;
  }
  .story__title {
    margin-bottom: 28px;
    font-size: clamp(40px, 5vw, 64px);
  }
  .story__first {
    margin: 0 0 18px;
  }
  .story__more {
    border-top: 1px solid var(--line-2);
  }
  .story__more summary {
    display: flex;
    justify-content: space-between;
    padding-block: 16px;
    font-size: 12px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--accent);
    cursor: pointer;
    list-style: none;
  }
  .story__more summary::-webkit-details-marker {
    display: none;
  }
  .story__more[open] summary span {
    transform: rotate(45deg);
  }
  .story__more summary span {
    transition: transform 0.3s;
  }
  .story__more p {
    margin: 0 0 18px;
    font-size: 17px;
    line-height: 1.7;
    color: var(--muted);
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin: 24px 0 0;
    padding-top: 24px;
    border-top: 1px solid var(--line-2);
  }
  .stats div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
  }
  .stats dd {
    margin: 0;
    font-size: 40px;
    line-height: 1.1;
    color: var(--accent);
  }
  .stats dt {
    margin-top: 4px;
    font-size: 13px;
    line-height: 1.5;
    color: var(--muted);
  }
  @media (max-width: 560px) {
    .story__media {
      min-height: 480px;
    }
    .story__main {
      inset: 0 24px 110px 0;
    }
    .story__inset {
      width: 160px;
      height: 120px;
      bottom: 70px;
    }
    .story__caption {
      right: 0;
    }
    .stats {
      grid-template-columns: 1fr;
    }
  }
</style>